{
  "_comment": "The AutomationTask launch contract, shared by the pytest tier (tests/unit/test_task_launch_cases.py) and the vitest tier (web/src/tests/taskLaunchCases.test.ts). `source` is compared as a task attribute rather than a payload key. Only the keys listed in `contract` are compared: they are the ones the builder owns, so a difference in how each language normalizes a nested SavedSearch filter cannot masquerade as contract drift. `job` is the DirectApplyTarget a direct_apply case builds from, and is absent for every other kind. A case with `expect_error` states something the contract must refuse rather than a payload to build. Since issue #298 only 拒信清扫 has a `mode`: a search and a targeted application take their execution depth from their Target Action, so `mode: null` is the normal shape for them and a stated mode is the error case.",
  "defaults": {
    "min_score": 70,
    "max_jobs": 30,
    "preview_timeout_sec": 3.0,
    "direct_apply_min_score": 0
  },
  "cases": [
    {
      "case": "search-save-jd-sends-nothing",
      "note": "A 深度存JD strategy never sends: the Target Action is the whole depth statement, and nothing in the payload votes again (issue #298).",
      "kind": "search",
      "source": "manual",
      "mode": null,
      "search": {
        "id": "s_save",
        "name": "深度存JD",
        "keyword": "agent",
        "enable_search": true,
        "enable_filter": true,
        "target_action": "save_jd",
        "max_jobs": 5
      },
      "min_score": null,
      "chat": null,
      "contract": [
        "saved_search_id",
        "search_id",
        "search_name",
        "keyword",
        "enable_search",
        "enable_filter",
        "target_action",
        "max_jobs",
        "min_score",
        "preview_only",
        "auto_send",
        "preview_timeout_sec"
      ],
      "expected": {
        "task_type": "SCRAPE_JOBS",
        "payload": {
          "saved_search_id": "s_save",
          "search_id": "s_save",
          "search_name": "深度存JD",
          "keyword": "agent",
          "enable_search": true,
          "enable_filter": true,
          "target_action": "save_jd",
          "max_jobs": 5,
          "min_score": 70,
          "preview_only": true,
          "auto_send": false,
          "preview_timeout_sec": 3.0
        },
        "source": "manual"
      }
    },
